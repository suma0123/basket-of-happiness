// Prisma schema for Basket of Happiness

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  phone        String?
  role         String         @default("CUSTOMER") // "CUSTOMER" or "ADMIN"
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  addresses    UserAddress[]
  orders       Order[]
  wishlist     WishlistItem[]
  reviews      Review[]
}

model UserAddress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  house        String
  street       String
  city         String
  state        String
  pinCode      String
  phone        String
  isDefault    Boolean  @default(false)
  instructions String?
  createdAt    DateTime @default(now())
}

model Category {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  description  String?
  image        String
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  products     Product[]
}

model Product {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  description            String
  specifications         String? // newline or json formatted specs
  price                  Int // In INR (e.g. 1499)
  originalPrice          Int?
  discountPercent        Int?
  stock                  Int                     @default(40)
  isAvailable            Boolean                 @default(true)
  isFeatured             Boolean                 @default(false)
  occasion               String // Birthday, Anniversary, Thank You, Baby Gifts, Just Because, For Him, For Her, Festive Gifts
  giftType               String? // Hamper, Box, Flowers, Keepsake, Candle, Sweet Box
  rating                 Float                   @default(4.9)
  reviewCount            Int                     @default(0)
  tags                   String? // comma-separated keywords
  categoryId             String?
  category               Category?               @relation(fields: [categoryId], references: [id])
  images                 ProductImage[]
  personalisationOptions PersonalisationOption[]
  reviews                Review[]
  orderItems             OrderItem[]
  wishlistItems          WishlistItem[]
  customHamperItems      CustomHamperConfigItem[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model ProductImage {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  alt          String?
  isPrimary    Boolean @default(false)
  displayOrder Int     @default(0)
}

model PersonalisationOption {
  id                 String   @id @default(cuid())
  productId          String?
  product            Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  title              String   @default("Custom Gifting Options")
  allowRecipientName Boolean  @default(true)
  allowCustomMessage Boolean  @default(true)
  allowGiftCard      Boolean  @default(true)
  allowPhotoUpload   Boolean  @default(true)
  allowGiftWrap      Boolean  @default(true)
  giftWrapPrice      Int      @default(99)
  availableColors    String? // JSON array e.g. ["Rose Gold", "Warm Champagne", "Emerald Velvet", "Classic Navy"]
  additionalPrice    Int      @default(0)
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique // e.g. BOH-2026-7842
  userId               String?
  user                 User?       @relation(fields: [userId], references: [id])
  customerName         String
  customerEmail        String
  customerPhone        String
  house                String
  street               String
  city                 String
  state                String
  pinCode              String
  deliveryInstructions String?
  deliveryMethod       String      @default("STANDARD") // STANDARD, EXPRESS, SAME_DAY
  estimatedDelivery    String?
  giftMessage          String?
  giftWrap             Boolean     @default(false)
  giftWrapTheme        String?
  subtotal             Int
  discount             Int         @default(0)
  couponCode           String?
  shippingFee          Int         @default(0)
  totalAmount          Int
  paymentMethod        String      @default("RAZORPAY") // RAZORPAY, UPI, CARD, COD, TEST_PAYMENT
  paymentStatus        String      @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paymentTransactionId String?
  fulfilmentStatus     String      @default("ORDER_PLACED") // ORDER_PLACED, PAYMENT_CONFIRMED, PROCESSING, PACKED, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  trackingNumber       String?
  trackingCarrier      String?
  notes                String?
  items                OrderItem[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  productName     String
  productImage    String
  unitPrice       Int
  quantity        Int
  totalPrice      Int
  recipientName   String?
  customMessage   String?
  giftCardMessage String?
  customPhotoUrl  String?
  chosenColor     String?
  customDetails   String? // JSON text
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String    @default("PERCENTAGE") // PERCENTAGE or FIXED
  discountValue Int
  minOrderValue Int       @default(0)
  maxDiscount   Int?
  validUntil    DateTime?
  isActive      Boolean   @default(true)
  usageCount    Int       @default(0)
}

model Review {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?    @relation(fields: [userId], references: [id])
  authorName         String
  customerPhoto      String?
  rating             Int      @default(5)
  comment            String
  isVerifiedPurchase Boolean  @default(true)
  isApproved         Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model Banner {
  id           String   @id @default(cuid())
  title        String
  subtitle     String?
  link         String?
  ctaText      String?
  imageUrl     String
  type         String   @default("HERO") // HERO, PROMO_BAR, SEASONAL
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
}

model HamperBox {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  description    String
  price          Int                  // In INR (e.g. 199, 299, 499, 699)
  dimensions     String?              // e.g. "Small (20x15x8 cm)"
  capacity       String?              // e.g. "Holds 3–5 items"
  image          String
  isAvailable    Boolean              @default(true)
  displayOrder   Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  configurations CustomHamperConfig[]
}

model CustomHamperConfig {
  id            String                   @id @default(cuid())
  userId        String?
  boxId         String
  box           HamperBox                @relation(fields: [boxId], references: [id])
  occasion      String                   @default("Just Because")
  wrappingTheme String                   @default("Classic")
  wrappingPrice Int                      @default(0)
  ribbonColor   String                   @default("Warm Champagne")
  senderName    String?
  recipientName String?
  cardMessage   String?
  extrasDetails String?                  // JSON text of optional extras
  subtotal      Int
  totalPrice    Int
  createdAt     DateTime                 @default(now())
  items         CustomHamperConfigItem[]
}

model CustomHamperConfigItem {
  id              String             @id @default(cuid())
  configurationId String
  configuration   CustomHamperConfig @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  productId       String
  product         Product            @relation(fields: [productId], references: [id])
  quantity        Int                @default(1)
  unitPrice       Int
  selectedVariant String?
}
